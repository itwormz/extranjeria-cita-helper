<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user installer without questions: no administrator rights, no folder or licence pages, only the progress bar.
     Same shape as the Python version's MSI. Built with WiX 4: wix build SantaCita.wxs -arch x64 -d Version=0.4.0.1 -d SourceDir=<folder> -d IconFile=<icon.ico> -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SantaCita" Manufacturer="itwormz" Version="$(Version)"
           UpgradeCode="42DDB187-3A0C-5D7D-BC5B-DB5BA305900E" Scope="perUser" InstallerVersion="500">
    <!-- Beta builds differ only in the fourth version field, which Windows Installer ignores when comparing,
         so a same-version package must still replace the installed one. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPCOMMENTS" Value="Appointment helper for Extranjería: fingerprinting and autorización de regreso" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/itwormz/santacita" />
    <!-- A small .ico, not the program itself: using the exe here would embed a second copy of it in the MSI. -->
    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SantaCita" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenu" Name="SantaCita" />
    </StandardDirectory>

    <Feature Id="Application" Title="SantaCita" Level="1">
      <Component Id="ApplicationExe" Directory="INSTALLFOLDER" Guid="55A2F2A3-5DCD-5C0D-83AB-81B433941A60">
        <File Id="SantaCitaExe" Source="$(SourceDir)\SantaCita.exe" />
        <RegistryValue Root="HKCU" Key="Software\itwormz\SantaCita\Components" Name="exe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseText" Directory="INSTALLFOLDER" Guid="B10E8D98-9765-5A47-B986-D114D276CB68">
        <File Id="LicenseFile" Source="$(SourceDir)\LICENSE.txt" />
        <RegistryValue Root="HKCU" Key="Software\itwormz\SantaCita\Components" Name="license" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="AppMenu" Guid="F12DFCC3-8950-50BA-BD9B-F3CBAF194514">
        <Shortcut Id="StartMenuLink" Name="SantaCita" Target="[INSTALLFOLDER]SantaCita.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon">
          <!-- The identifier the application registers for desktop notifications. -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="com.itwormz.santacita" />
        </Shortcut>
        <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\itwormz\SantaCita" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
