{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SantaCita",
  "identifier": "com.itwormz.santacita",
  "build": {
    "frontendDist": "../../.local/builds/work/rust-ui-dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "node scripts/build.mjs",
      "cwd": "../../desktop-ui"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Помощник для поиска сит в Extranjería",
    "icon": [
      "../../.local/builds/work/rust-ui-icons/icon.png",
      "../../.local/builds/work/rust-ui-icons/32x32.png",
      "../../.local/builds/work/rust-ui-icons/128x128.png",
      "../../.local/builds/work/rust-ui-icons/128x128@2x.png",
      "../../.local/builds/work/rust-ui-icons/icon.icns",
      "../../.local/builds/work/rust-ui-icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "../../assets/dmg-background.png",
        "windowSize": {
          "width": 600,
          "height": 460
        },
        "appPosition": {
          "x": 150,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 190
        }
      }
    }
  }
}
