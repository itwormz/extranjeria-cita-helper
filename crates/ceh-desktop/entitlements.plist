<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app loads NSS from the user's own Firefox to cache one public TLS intermediate in the app's
	     browser profile. Firefox is signed by Mozilla, so the hardened runtime must allow foreign libraries. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
